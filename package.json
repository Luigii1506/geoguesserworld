{
  "name": "geomastery",
  "private": true,
  "version": "0.1.0",
  "description": "Academia personal de aprendizaje geográfico para GeoGuessr",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "pipeline": "node --disable-warning=ExperimentalWarning pipeline/run.mjs",
    "release": "npm run build && npm run pipeline -- geo publish"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.1.0",
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "topojson-client": "^3.1.0",
    "ts-fsrs": "^5.4.2",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.705.0",
    "@playwright/test": "^1.63.0",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.1",
    "sharp": "^0.33.5",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.7"
  }
